KARAKEEP_BASE_URL=https://karakeep.example.com
KARAKEEP_API_TOKEN=karakeep_api_key_from_settings
# Karakeep REST API prefix. Default is /api/v1.
KARAKEEP_API_PATH=/api/v1
OPDS_USERNAME=reader
OPDS_PASSWORD=change_this_long_password
OPDS_PAGE_SIZE=50
# Optional. Use when behind a reverse proxy and generated links need a public origin.
# SERVICE_BASE_URL=https://opds.example.com
